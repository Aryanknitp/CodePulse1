# Dependency directories
node_modules/
jspm_packages/

# Local environment files (DO NOT commit your actual secrets)
.env
.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# Keep .env.example tracked by git (explicitly ensuring it's not ignored)
!.env.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt string replace build folders
.grunt

# Bower dependency directory
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org)
build/Release

# Dependency directories for IDEs and editors
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

