# ==========================================
# 📦 Dependency Directories & Build Outputs
# ==========================================
node_modules/
jspm_packages/
bower_components/
.venv/
env/
venv/

# ==========================================
# 🐍 Python Runtime & Cache Files
# ==========================================
__pycache__/
*.py[cod]
*$py.class

# ==========================================
# 🔑 Environment Configurations (Secrets)
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# DO NOT include !.env.example here if you intend to delete it globally

# ==========================================
# 🪵 Logs & Diagnostics
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# 🛠️ System, IDE, and IDE Caches
# ==========================================
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# ==========================================
